# Configuración del servidor
PORT=3000

# Auth
JWT_SECRET=reemplaza_con_un_secreto_aleatorio_de_32_caracteres_o_mas
ADMIN_EMAIL=admin@test.com

# Opcional: en hosting, apunta al disco persistente (por ejemplo /var/data)
DATA_DIR=

# Correo para recuperación de contraseña
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Notas:
# - En desarrollo sin SMTP, el token de recuperación se devuelve para pruebas
# - En producción, configura SMTP para habilitar la recuperación de contraseña
# - SMTP_HOST, SMTP_USER y SMTP_PASS deben configurarse juntos para activar correo
# - Para Gmail, usa contraseña de aplicación, no tu contraseña normal
